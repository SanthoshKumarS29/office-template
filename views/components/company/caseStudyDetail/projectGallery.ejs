<section>
    <div class="py-5">
        <div class="text-start">
            <p class="section-title"><%= page.gallery.sectionLabel %></p>
            <h2 class="head-txt-h2">
                <%= page.gallery.titlePrefix %>
                <span class="theme-grad-text"><%= page.gallery.titleHighlight %></span>
            </h2>
        </div>
        <div class="row justify-content-center g-4 pt-4">
            <% page.gallery.items.forEach((item) => { %>
                <div class="col-md-6 col-xl-4">
                    <div class="csd-project-gal-card">
                        <div class="overflow-hidden">
                            <img src="<%= item.image %>"
                                alt="<%= item.alt %>" class="csd-pg-image" width="450"
                                height="300" loading="lazy">
                        </div>
                        <div class="csd-pg-caption-container flex-x justify-content-between align-items-center">
                            <p class="card-txt-p mb-0"><%= item.caption %></p>
                            <p class="card-txt-p theme-grad-text mb-0"><%= item.index %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>