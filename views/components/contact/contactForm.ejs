<section>
    <div class="pb-5 half-bg">
        <div class="col-lg-8 mx-auto text-center flex-y gap-3 px-3 pt-5 pb-4 text-white">
            <h1 class="head-txt-h1">Get In <span class="theme-grad-text">Touch</span></h1>
            <p class="para-txt-head text-white-50">Let's discuss your project and explore how we can build innovative digital solutions together.</p>
        </div>
        <div class="col-xl-10 mx-auto mt-4 contact-shadow">
            <div class="row justify-content-center p-3 g-0">
                <div class="col-md-5 col-lg-4">
                    <div class="contact-info">
                        <div class="flex-y align-items-start gap-4">
                            <h2 class="head-txt-h3 text-white">Contact Information</h2>
                            <p class="text-white-50 para-txt-sm">Have some big idea or brand to develop and need help? Then reach out we'd love to hear about your project and provide help.</p>
                        </div>
                        <div class="flex-x gap-2 align-items-center">
                            <div class="contactMailIcon">
                                <svg width="28" height="28">
                                    <use href="/images/svg/common.svg#telPhone-icon" />
                                </svg>
                            </div>
                            <p class="ci-text text-white-50 mb-0">+91 89774689823</p>
                        </div>
                        <div class="flex-x gap-2 align-items-center">
                           <div class="contactMailIcon">
                                <svg width="28" height="28">
                                    <use href="/images/svg/common.svg#email-icon" />
                                </svg>
                            </div>
                            <p class="ci-text text-white-50 mb-0">companyName@gmail.com</p>
                        </div>
                        <div class="flex-x gap-2 align-items-center">
                            <div class="contactMailIcon">
                                <svg width="28" height="24">
                                    <use href="/images/svg/common.svg#location-icon" />
                                </svg>
                            </div>
                            <p class="ci-text mb-0 text-white-50">55 Main Street, 2nd block Malborne, India</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-7 col-lg-8">
                    <div class="px-1 py-4 px-md-4 py-md-4 px-xxl-5 py-xxl-5">
                        <form class="row justify-content-center g-3 contact-form" data-formtype="contact">
                            <div class="col-md-6">
                                <div class="flex-y">
                                    <label for="name" class="contact-form-label">Enter Your Name:</label>
                                    <input type="text" name="name" id="name" class="contact-form-feild" placeholder="Name"
                                        autocomplete="name">
                                    <span class="feildError" id="nameError"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="flex-y">
                                    <label for="email" class="contact-form-label">Enter Your Email:</label>
                                    <input type="email" name="email" id="email" class="contact-form-feild" placeholder="Email"
                                        autocomplete="email">
                                    <span class="feildError" id="emailError"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div>
                                    <div class="flex-y">
                                        <label for="email" class="contact-form-label">Enter Your Number:</label>
                                        <input id="phone-contact" name="phone" class="iti-input contact-form-feild" type="tel"
                                            placeholder="Phone/Whatsapp number" />
                                        <span class="feildError" id="phoneError"></span>
                                    </div>
                                    <!-- optional hidden fields (not required, we'll append in JS) -->
                                    <input type="hidden" name="countryCode" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="flex-y">
                                    <label for="message" class="contact-form-label">Enter Your Message:</label>
                                    <textarea name="message" id="message" class="contact-form-feild" placeholder="Message" rows="5"
                                        autocomplete="off"></textarea>
                                    <span class="feildError" id="messageError"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex flex-wrap justify-content-center justify-content-md-between align-items-center gap-4">
                                    <div class="button-wrapper">
                                        <div class="button-glow-blue"></div>
                                        <button type="submit" class="theme-btn">Send Message
                                            <svg class="arrow" viewBox="0 0 10 10" width="10" height="10" fill="none">
                                                <path class="line" d="M0 5h7"></path>
                                                <path class="arrow-head" d="M1 1l4 4-4 4"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <div>
                                        <p class="para-txt-sm mb-0">We reply within 24 hours.</p>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>