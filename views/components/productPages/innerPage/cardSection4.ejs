<section>
    <div class="py-5">
        <div class="row justify-content-between g-3 text-center text-xl-start">
            <div class="col-xl-4">
                <div class="flex-y align-items-center gap-2 align-items-xl-start">
                    <p class="ip-higlighter fw-bold mb-0">
                        <%= page.cardSectionFour.tag %>
                    </p>
                    <h2 class="head-txt-h2 mb-3"><%- page.cardSectionFour.title %></h2>
                </div>
            </div>
            <div class="col-xl-7">
                <p class="para-txt-head mb-0">
                    <%= page.cardSectionFour.description %>
                </p>
            </div>
        </div>
        <div class="ip-cardSectionFour-parent">
            <div class="ip-csf-child1">
                <div class="ip-csf-box">
                    <h3 class="card-txt-h">Business-First Thinking</h3>
                    <p class="card-txt-p">We begin with the workflow, users, and business objective before selecting the technology.</p>
                </div>
            </div>
            <div class="ip-csf-child2">
                <div class="ip-csf-box">
                    <h3 class="card-txt-h">Custom Architecture</h3>
                    <p class="card-txt-p">Your agent is designed around your systems, data, integrations, and operational requirements.</p>
                </div>
            </div>
            <div class="ip-csf-child3">
                <div class="ip-csf-clrbg"></div>
            </div>
            <div class="ip-csf-child4">
                <div class="ip-csf-box">
                    <h3 class="card-txt-h">Controlled Automation</h3>
                    <p class="card-txt-p">Define what the agent can access, what actions it can perform, and where human approval is required.</p>
                </div>
            </div>
            <div class="ip-csf-child5">
                <div class="ip-csf-box">
                    <h3 class="card-txt-h">Scalable Foundation</h3>
                    <p class="card-txt-p">Build the solution with future integrations, changing workflows, and growing usage in mind.</p>
                </div>
            </div>
        </div>
    </div>
</section>