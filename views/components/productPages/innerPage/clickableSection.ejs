<section>
    <div class="py-5">
        <div class="row justify-content-between g-3 text-center text-xl-start">
            <div class="col-xl-4">
                <div class="flex-y align-items-center gap-2 align-items-xl-start">
                    <p class="ip-higlighter fw-bold mb-0"><%= page.clickableSec.tag %></p>
                    <h2 class="head-txt-h2 mb-3"><%- page.clickableSec.title %></h2>
                </div>
            </div>
            <div class="col-xl-7">
                <p class="para-txt-head mb-0"><%= page.clickableSec.description %></p>
            </div>
        </div>
        <div class="row justify-content-between g-3 pt-4">
            <div class="col-xl-5">
                <div class="ip-clickable-box"></div>
            </div>
            <div class="col-xl-7">
                <div class="flex-y gap-3">
                    <% page.clickableSec.content.forEach(conts => { %>
                        <div class="ip-clickable-container">
                            <div class="curson-pointer">
                                <h3 class="card-txt-h"><%= conts.headTxt %></h3>
                            </div>
                            <div class="ip-clickable-para-container">
                                <p class="card-txt-p text-white"><%= conts.paraTxt %></p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</section>