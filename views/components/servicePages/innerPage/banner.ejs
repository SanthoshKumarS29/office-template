<section>
    <div class="ip-banner-container">
        <div class="flex-y gap-4 gap-xl-5 justify-content-center align-items-start">
            <h1 class="ip-banner-headTxt"><%- page.banner.title %></h1>
            <div class="row justify-content-between g-3">
                <div class="col-md-6 col-xl-4">
                    <p class="ip-higlighter fw-medium"><%= page.banner.tag %></p>
                </div>
                <div class="col-md-6 col-xl-7">
                    <div class="flex-y align-items-start gap-3">
                        <p class="para-txt-head"><%= page.banner.content %> </p>
                        <div class="button-wrapper">
                            <div class="button-glow-blue"></div>
                            <a href="/contact-us" class="theme-btn">Discuss Your Project
                                <svg class="arrow" viewBox="0 0 10 10" width="10" height="10" fill="none">
                                    <path class="line" d="M0 5h7"></path>
                                    <path class="arrow-head" d="M1 1l4 4-4 4"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>