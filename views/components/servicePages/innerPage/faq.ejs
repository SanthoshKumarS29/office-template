<section>
    <div class="py-5">
        <div class="row justify-content-center g-4">
            <div class="col-xl-6">
                <div class="flex-y gap-3">
                    <div class="flex-y gap-1">
                        <p class="para-txt-head mb-0"><%= page.faq.subTitle %></p>
                        <h2 class="head-txt-h2"><%- page.faq.title %></h2>
                    </div>
                    <div class="accordion" id="faqAccordion">
                        <% page.faq.qnsAns.forEach((qnaItems, i)=> { %>
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="heading<%= i %>">
                                    <button class="accordion-button text-normal-sm <%= i !== 0 ? 'collapsed' : '' %>"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= i %>"
                                        aria-expanded="<%= i === 0 ? 'true' : 'false' %>"
                                        aria-controls="collapse<%= i %>">
                                        <%= qnaItems.qns %>
                                    </button>
                                </h3>
                                <div id="collapse<%= i %>"
                                    class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>"
                                    data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        <p class="text-normal">
                                            <%= qnaItems.ans %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="ip-faq-cta">
                    <h3 class="theme-grad-text"><%= page.faq.ctaHead %></h3>
                    <p class="para-txt text-white"><%= page.faq.ctaDes %></p>
                    <div class="button-wrapper">
                        <div class="button-glow-blue"></div>
                        <a href="/contact-us" class="theme-btn-white"><%= page.faq.ctaBtnTxt %>
                            <svg class="arrow-black" viewBox="0 0 10 10" width="10" height="10" fill="none">
                                <path class="line" d="M0 5h7"></path>
                                <path class="arrow-head" d="M1 1l4 4-4 4"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>