<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../components/partials/headMeta.ejs') %>
    <%- include('../../components/partials/headLinks.ejs') %>
    <link rel="stylesheet" href="/css/hubpage.css">
    <style>
        .explore-more-wrap {
            padding: 40px 0 60px;
        }

        .explore-more-title {
            margin-bottom: 24px;
        }

        .explore-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .category-header{
            margin-bottom: 1rem;
        }

        .explore-link{
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: var(--black-clr);
            font-size: 1rem;
            padding: 1rem .5rem;
            transition: .3s ease-in-out;
        }

        .explore-link-content{
            font-weight: 500;
        }

        .explore-link:hover:nth-child(even){
            color: var(--orange-clr);
        }

        .explore-link:hover:nth-child(odd){
            color: var(--blue-clr);
        }

    </style>
</head>
<body>
    <header>
        <%- include('../../components/partials/header.ejs') %>
    </header>
    <main class="bodyflex">
        <aside class="sidebar-links" id="sidebar">
            <%- include('../../components/partials/sideBar.ejs') %>
        </aside>
        <div class="custom-container">
            <section class="explore-more-wrap">
                <div class="explore-more-title">
                    <h2 class="section-title">Explore More</h2>
                    <p class="para-txt-head mb-0">Browse all navigation links grouped by category.</p>
                </div>

                <div class="explore-grid">
                    <% nav.exploreMore.categories.forEach(category => { %>
                        <div class="explore-category">
                            <div class="category-header">
                                <h3 class="head-txt-h3"><%= category.name %></h3>
                            </div>
                            <div class="category-links">
                                <% category.links.forEach(link => { %>
                                    <a href="<%= link.url %>" class="explore-link" rel="<%= link.rel %>">
                                        <span class="mb-0"><%= link.title %></span>
                                        <span class="explore-arrow">↗</span>
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </div>
    </main>
    <footer class="custom-container border-1 border-top">
        <%- include('../../components/partials/footer.ejs') %>
        <%- include('../../components/partials/footerLinks.ejs') %>
    </footer>
</body>
</html>
