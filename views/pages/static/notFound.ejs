<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../components/partials/headMeta.ejs') %>
    <%- include('../../components/partials/headLinks.ejs') %>
    <style>
        .status-screen {
            min-height: min(72vh, 760px);
            display: grid;
            place-items: center;
            padding: clamp(2.5rem, 7vw, 5.5rem) 1rem;
        }

        .status-card {
            position: relative;
            isolation: isolate;
            width: min(100%, 760px);
            overflow: hidden;
            padding: clamp(2rem, 7vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem);
            border: 1px solid rgba(25, 118, 210, .12);
            border-radius: 1.5rem;
            background: linear-gradient(145deg, #fff 30%, #f5f8fc 100%);
            text-align: center;
        }

        .status-card::before,
        .status-card::after {
            position: absolute;
            z-index: -1;
            content: "";
            border-radius: 50%;
            pointer-events: none;
        }

        .status-card::before {
            top: -9rem;
            right: -7rem;
            width: 18rem;
            height: 18rem;
            background: var(--grad-clr-o-lig);
        }

        .status-card::after {
            bottom: -12rem;
            left: -9rem;
            width: 20rem;
            height: 20rem;
            border: 1px solid rgba(25, 118, 210, .12);
        }

        .status-art {
            position: relative;
            display: grid;
            width: clamp(9rem, 30vw, 13rem);
            aspect-ratio: 1;
            place-items: center;
            margin: 0 auto 1.5rem;
            border: 1px solid rgba(25, 118, 210, .14);
            border-radius: 50%;
            background: rgba(255, 255, 255, .76);
            box-shadow: 0 16px 40px rgba(25, 118, 210, .1);
        }

        .status-art::before,
        .status-art::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(25, 118, 210, .16);
            border-radius: 50%;
        }

        .status-art::before {
            inset: 12%;
        }

        .status-art::after {
            inset: 24%;
            background: var(--grad-clr-o-lig);
        }

        .status-code {
            position: relative;
            z-index: 1;
            color: var(--dark-blue);
            font-family: "RobotoLocal", sans-serif;
            font-size: clamp(3.5rem, 12vw, 6rem);
            font-weight: 700;
            letter-spacing: -.08em;
            line-height: 1;
        }

        .status-eyebrow {
            margin: 0 0 .65rem;
            color: var(--blue-clr);
            font-family: "PoppinsLocal", sans-serif;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .status-title {
            margin: 0;
            color: var(--dark-blue);
            font-family: "RobotoLocal", sans-serif;
            font-size: clamp(1.8rem, 5vw, 2.6rem);
            font-weight: 700;
            line-height: 1.2;
        }

        .status-copy {
            max-width: 34rem;
            margin: 1rem auto 1.75rem;
            color: var(--grey-clr2);
            font-family: "PoppinsLocal", sans-serif;
            font-size: 1rem;
            line-height: 1.8;
        }

        .status-home-link {
            display: inline-flex;
            min-height: 3rem;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            padding: .75rem 1.35rem;
            border: 1px solid var(--blue-clr);
            border-radius: .5rem;
            background: var(--blue-clr);
            color: var(--white-clr);
            font-family: "PoppinsLocal", sans-serif;
            font-size: .95rem;
            font-weight: 500;
            text-decoration: none;
            transition: background-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .status-home-link:hover {
            transform: translateY(-2px);
            background: #1265b8;
            color: var(--white-clr);
            box-shadow: 0 10px 24px rgba(25, 118, 210, .24);
        }

        .status-home-link:focus-visible {
            outline: 3px solid var(--orange-clr);
            outline-offset: 3px;
        }

        @media (prefers-reduced-motion: reduce) {
            .status-home-link {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <header>
        <%- include('../../components/partials/header.ejs') %>
    </header>
    <main class="bodyflex">
        <aside class="sidebar-links" id="sidebar">
            <%- include('../../components/partials/sideBar.ejs') %>
        </aside>    
        <div class="custom-container">
            <section class="status-screen" aria-labelledby="not-found-title">
                <div class="status-card">
                    <div class="status-art" aria-hidden="true">
                        <span class="status-code">404</span>
                    </div>
                    <p class="status-eyebrow">Page not found</p>
                    <h1 class="status-title" id="not-found-title">This page took a wrong turn.</h1>
                    <p class="status-copy">The link may be outdated, or the page may have moved. Let’s get you back to somewhere familiar.</p>
                    <a href="/" class="status-home-link">
                        <span aria-hidden="true">&larr;</span>
                        Back to home
                    </a>
                </div>
            </section>
        </div>
    </main>
    <footer class="custom-container border-1 border-top">
        <%- include('../../components/partials/footer.ejs') %>
        <%- include('../../components/partials/footerLinks.ejs') %>
    </footer>
</body>
</html>